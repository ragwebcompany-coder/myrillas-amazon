{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/dr-k-myrillas/",
      "destination": "/gynaikologos-dr-k-myrillas/",
      "permanent": true
    },
    {
      "source": "/newsletter/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/robotiki-xeirourgiki/",
      "destination": "/services/robotiki-xeirourgiki/",
      "permanent": true
    },
    {
      "source": "/testimonials/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/page/:n/",
      "destination": "/blog/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(img|docs)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}